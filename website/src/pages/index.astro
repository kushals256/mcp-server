---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ChatDemo from '../components/ChatDemo.astro';
import MacScreenDemo from '../components/MacScreenDemo.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import UspPillars from '../components/UspPillars.astro';
import { route } from '../utils/paths';

const dmgUrl = 'https://github.com/kushals256/mcp-server/releases/latest/download/DatasetAnalysisMCP.dmg';

const prompts = [
  'Find outliers in my sales CSV',
  'Normalize messy category names before encoding',
  'Split for ML and export the pipeline config',
  'What quality issues does this dataset have?',
];

const steps = [
  { title: 'Before you start', body: 'DMG → Applications, Python 3.10+, and Claude Desktop installed.' },
  { title: 'One click in Prism', body: 'Open Prism, review the checklist, click Set up Prism — progress and notifications guide you.' },
  { title: 'Finish in Claude', body: 'Quit Claude (Cmd+Q), reopen it, and paste the starter prompt.' },
];

const trust = ['Data never in chat', 'Version history', 'ML guardrails', 'Runs locally'];
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative mx-auto max-w-6xl px-6 pb-24 pt-20 md:pb-32 md:pt-28">
    <div class="grid items-center gap-16 lg:grid-cols-2 lg:gap-12">
      <div class="reveal">
        <span class="eyebrow">
          <span class="h-1.5 w-1.5 rounded-full bg-prism-lime"></span>
          Local data lab for Claude
        </span>
        <h1 class="section-title mt-8">
          Claude thinks.<br />
          <span class="text-gradient">Prism executes.</span>
        </h1>
        <p class="section-subtitle">
          29 tested tools. Your data stays on disk — not in chat. Every step logged, versioned, and exportable.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={dmgUrl} class="btn-primary">Download for Mac</a>
          <a href={route('install')} class="btn-secondary">Manual install</a>
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          {trust.map((item) => (
            <span class="trust-pill">{item}</span>
          ))}
        </div>
      </div>

      <div class="reveal reveal-delay-2">
        <ChatDemo />
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="reveal">
      <SectionHeader
        label="The difference"
        title="Why not just Claude?"
        subtitle="Claude can write pandas. Prism gives you a stateful lab with undo, guardrails, and exportable pipelines."
      />
    </div>
    <div class="reveal mt-12">
      <ComparisonTable />
    </div>
  </section>

  <!-- Prompts -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="reveal">
      <SectionHeader
        label="Starter prompts"
        title="Ask Claude things like"
        subtitle="Natural language in, structured data work out. No boilerplate scripts."
      />
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {prompts.map((prompt, i) => (
        <div class={`prompt-card reveal reveal-delay-${(i % 3) + 1}`}>
          <p class="relative pr-8 text-white/85">{prompt}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Mac screen -->
  <section class="mx-auto max-w-5xl px-6 py-24">
    <div class="reveal text-center">
      <SectionHeader
        label="On your Mac"
        title="Feels native in Claude"
        subtitle="Ask in plain English. Prism runs the pipeline on your Mac — Claude never sees your rows."
        centered={true}
      />
    </div>
    <div class="reveal mt-14">
      <MacScreenDemo />
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="reveal">
      <SectionHeader
        label="Getting started"
        title="How it works"
        subtitle="From install to first analysis in under five minutes. Prism shows what it automates and what you still do manually."
        centered={true}
      />
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {steps.map((step, index) => (
        <div class={`step-card reveal reveal-delay-${index + 1}`}>
          <div class="step-number">0{index + 1}</div>
          <h3 class="text-xl font-semibold text-white">{step.title}</h3>
          <p class="mt-3 leading-relaxed text-white/55">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- USP pillars -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="reveal">
      <UspPillars />
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-6 py-20 pb-28">
    <div class="cta-band reveal flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <div class="relative z-10">
        <h2 class="text-3xl font-semibold tracking-tight text-white md:text-4xl">
          Claude thinks. Prism executes.
        </h2>
        <p class="mt-3 text-lg text-white/55">Install on Mac, connect Claude, and run your first pipeline.</p>
      </div>
      <a href={dmgUrl} class="btn-primary relative z-10 shrink-0">Download for Mac</a>
    </div>
  </section>
</BaseLayout>
