---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrismLogo from '../components/PrismLogo.astro';

const dmgUrl = 'https://github.com/kushals256/mcp-server/releases/latest/download/DatasetAnalysisMCP.dmg';

const easySteps = [
  'Download and open the DMG',
  'Drag Prism to Applications',
  'Open Prism and click "Set up Prism"',
  'Quit Claude Desktop (Cmd+Q), reopen it, and try a starter prompt',
];

const manualChecklist = [
  'Run: pip install dataset-analysis-mcp && dataset-analysis-mcp-setup',
  'Run dataset-analysis-mcp-doctor and confirm green checks',
  'Quit Claude Desktop completely (Cmd+Q)',
  'Reopen Claude and try a starter prompt',
];
---

<BaseLayout title="Install Prism" description="Easy DMG setup for Mac, or manual pip install for developers.">
  <section class="page-hero mx-auto max-w-4xl px-6">
    <div class="reveal">
      <PrismLogo size="md" subtitle={true} />
      <h1 class="section-title mt-8">Install on Mac</h1>
      <p class="section-subtitle">Most people: download the app and click one button. Developers: use Terminal.</p>
    </div>

    <div class="reveal mt-12 glass-strong p-8 md:p-10">
      <div class="mb-2 inline-flex rounded-full border border-prism-lime/30 bg-prism-lime/10 px-3 py-1 text-xs font-medium text-prism-lime">
        Recommended · Easy setup
      </div>
      <h2 class="mt-4 text-xl font-semibold text-white">Download Prism.app</h2>
      <p class="mt-2 text-sm leading-relaxed text-white/50">
        Open the app and click <strong class="text-white/70">Set up Prism</strong>. It installs the MCP server from
        <a href="https://pypi.org/project/dataset-analysis-mcp/" class="text-prism-lime hover:underline">PyPI</a>,
        writes your Claude config, copies sample data, and runs a health check — no Terminal needed.
      </p>
      <a href={dmgUrl} class="btn-primary mt-6 inline-flex">Download for Mac</a>
      <ol class="mt-8 space-y-3 text-sm text-white/70">
        {easySteps.map((step, index) => (
          <li class="flex gap-3">
            <span class="step-number !mb-0 h-7 w-7 shrink-0 text-xs">{index + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="reveal mt-6 glass-card p-8">
      <div class="mb-2 inline-flex rounded-full border border-white/15 bg-white/[0.04] px-3 py-1 text-xs font-medium text-white/50">
        Advanced · Manual setup
      </div>
      <h2 class="mt-4 text-xl font-semibold text-white">Terminal (pip)</h2>
      <p class="mt-2 text-sm text-white/50">For developers who prefer the command line.</p>
      <pre class="code-block mt-5" id="quick-start">pip install dataset-analysis-mcp && dataset-analysis-mcp-setup</pre>
      <button class="btn-secondary mt-5" data-copy="#quick-start">Copy command</button>
      <div class="mt-6 grid gap-3">
        {manualChecklist.map((item, index) => (
          <div class="rounded-xl border border-white/[0.06] bg-white/[0.03] px-4 py-3 text-sm text-white/70">
            <strong class="text-prism-lime">Step {index + 1}.</strong> {item}
          </div>
        ))}
      </div>
    </div>

    <div class="reveal mt-10 glass-card p-8">
      <div class="step-number mb-5">✦</div>
      <h2 class="text-xl font-semibold">Your first 5 minutes</h2>
      <pre class="code-block mt-4 text-xs" id="starter-prompt">Load ~/datasets/sample_sales.csv and run a data quality check</pre>
      <button class="btn-secondary mt-4 !px-5 !py-2.5 !text-xs" data-copy="#starter-prompt">Copy starter prompt</button>
    </div>

    <details class="faq-item reveal mt-10 p-8">
      <summary>Advanced: manual Claude config</summary>
      <p class="mt-4 text-sm text-white/50">~/Library/Application Support/Claude/claude_desktop_config.json</p>
      <pre class="code-block mt-4 text-xs" id="manual-config">{`{
  "mcpServers": {
    "dataset-analysis": {
      "command": "dataset-analysis-mcp",
      "args": [],
      "env": { "MCP_DATA_DIR": "~/datasets" }
    }
  }
}`}</pre>
    </details>
  </section>
</BaseLayout>
