---
import { asset } from '../utils/paths';
---

<div class="relative flex items-center justify-center py-4">
  <div class="logo-glow" aria-hidden="true"></div>
  <div class="logo-float">
    <div class="logo-frame p-5 md:p-7">
      <img
        src={asset('prism-logo-hero.png')}
        alt="Prism logo"
        class="h-48 w-48 object-contain md:h-64 md:w-64 lg:h-72 lg:w-72"
      />
    </div>
  </div>
</div>
