---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
}

const { label, title, subtitle, centered = false } = Astro.props;
const align = centered ? 'text-center items-center' : '';
---

<div class={`flex flex-col ${align}`}>
  {label && <p class="section-label">{label}</p>}
  <h2 class="section-title">{title}</h2>
  {subtitle && <p class={`section-subtitle ${centered ? 'mx-auto' : ''}`}>{subtitle}</p>}
</div>
